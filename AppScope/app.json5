{
  "app": {
    "bundleName": "com.jxg.huaweiobsidian",
    "vendor": "jxg",
    // versionCode 必须**单调递增**：它是装机唯一判定依据，调小会导致
    // 「install version downgrade code:9568263」——已装旧包的设备/模拟器一律装不上。
    // 语义版本放 versionName（0.2.0），这里只管递增：v0.1 是 1000000，v0.2 首包取 1000001。
    "versionCode": 1000003,
    "versionName": "0.2.0",
    "buildVersion": "1",
    "icon": "$media:layered_image",
    "label": "$string:app_name",
    // v1.10 系统字号：字体跟随系统缩放（fp 字号），应用级钳制上限 1.75
    // （适老化指南建议值，schema 见 SDK toolchains/modulecheck/configuration.json）。
    // 依据见 docs/harmonyos/api_notes.md AA1。
    "configuration": "$profile:configuration"
  }
}
