# ===== 依赖与构建产物 =====
**/node_modules
**/oh_modules
**/build
**/.hvigor
**/.cxx
**/.test

# ===== 本地 / IDE 配置 =====
/local.properties
/.idea
/.clangd
/.clang-format
/.clang-tidy
/.appanalyzer

# ===== 打包产物 =====
*.hap
*.hsp
*.har
*.app

# ===== 签名材料（含私钥，绝不入库；本仓库是公开 MIT 仓库）=====
*.p12
*.cer
*.p7b
*.csr
# 本地签名凭据（hvigorfile.ts 从这里读，build-profile.json5 保持 []）
local-signing.json
# DevEco 自动签名会往 build-profile.json5 写密码明文；剥离后的本地副本放这里
/.local/

# ===== 日志与系统垃圾 =====
*.log
*.hprof
.DS_Store
Thumbs.db

# ===== 本地工具残留（不入库） =====
/.workbuddy/
# DevEco Code 会话工作目录（临时截图 / 日志 / 崩溃现场等排查产物）
/.deveco/
# ArkTS 静态检查工具（deveco arkts_check）的本地缓存
/.cache/
# IDE 在项目根目录误建的嵌套空 git 仓库，会让 git add 失败（does not have a commit checked out）
/.codegenie/

# AGC credentials (do not commit)
.env
agc_private.json
__pycache__/
